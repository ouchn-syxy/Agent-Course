# 复制为 config.yaml 并填入你的 API Key 和模型参数
# config.yaml 不会提交到 Git（已在 .gitignore 中排除）

# --- LLM 连接配置 ---
llm:
  provider: "deepseek"
  base_url: "https://api.deepseek.com"
  model: "deepseek-v4-flash"
  api_key_env: "sk-..."

# --- 生成参数 ---
generation:
  temperature: 0.8
  top_p: 0.95
  max_tokens: 1024

# --- 角色配置 ---
profile:
  default: "luxun"

# --- 记忆配置 ---
memory:
  # 滑动窗口最大保留轮数
  max_turns: 20
  # 触发摘要压缩的 token 阈值
  max_tokens: 3000
