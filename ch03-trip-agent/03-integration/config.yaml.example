# 复制为 config.yaml 并填入你的 API Key 和模型参数
# config.yaml 不会提交到 Git（已在 .gitignore 中排除）

# --- LLM 连接配置 ---
llm:
  # 模型提供商（deepseek / qwen / zhipu / openai）
  provider: "deepseek"

  # API 地址（OpenAI SDK 兼容格式）
  # DeepSeek:  https://api.deepseek.com
  # Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
  # 智谱:     https://open.bigmodel.cn/api/paas/v4
  # OpenAI:    https://api.openai.com/v1
  base_url: "https://api.deepseek.com"

  # 模型名称
  # DeepSeek:  deepseek-v4-flash
  # Qwen:      qwen-turbo / qwen-plus / qwen-max
  # 智谱:     glm-4-flash / glm-4
  # OpenAI:    gpt-4o / gpt-4o-mini
  model: "deepseek-v4-flash"

  # API Key（直接在此填写你的密钥）
  api_key_env: "sk-..."

# --- 生成参数 ---
generation:
  # 温度（0-2），越高输出越随机，越低越确定
  temperature: 0.8
  # 核采样阈值（0-1），限制候选 token 的累积概率范围
  top_p: 0.95
  # 单次最大输出 token 数
  max_tokens: 4096

# --- Tavily 网页搜索 ---
tavily:
  # Tavily API Key（从 https://tavily.com 获取，免费额度 1000 次/月）
  api_key: "your-tavily-api-key-here"
  # 单次搜索返回最大结果数
  max_results: 5
  # 是否包含 AI 生成的综合回答（true=包含，false=仅返回原始搜索结果）
  include_answer: false